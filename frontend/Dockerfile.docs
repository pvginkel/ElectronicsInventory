# Multi-stage build for VitePress documentation site
# The build image (DockerImages, modern-app-frontend-build) carries Node and pnpm.
FROM registry:5000/modern-app-frontend-build AS build

WORKDIR /app

# Prime dependency cache
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# Copy source required for documentation build
COPY . .

# Build the VitePress site
RUN pnpm docs:build

FROM nginx:alpine AS production

# Reuse the existing nginx configuration
COPY nginx.conf /etc/nginx/nginx.conf

RUN rm -Rf /usr/share/nginx/html

# Publish the generated static documentation
COPY --from=build /app/docs/.vitepress/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
