# Flask configuration
SECRET_KEY=your-secret-key-here
FLASK_ENV=development
DEBUG=true

# Deployment tier: local-dev, dev, uat, prd, local-tst or tst. Unset, it is
# local-dev under FLASK_ENV=development, local-tst under testing, else prd.
# STAGE=local-dev

# An internal app shows internal detail (exception text in 500 responses, the
# frontend's diagnostics) even on prd. Every STAGE but prd shows it anyway.
HOMELAB_INTERNAL=false

# Server configuration
# Number of threads for Waitress WSGI server (production mode)
# For AI-heavy workloads with external API calls, higher thread counts improve concurrency
WAITRESS_THREADS=100

# Database configuration
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/electronics_inventory

# CORS configuration
CORS_ORIGINS=["http://localhost:3000"]

# Root log level: DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO

# Largest request body accepted, in MB; a larger one gets 413. The frontend's
# nginx stops bodies over 50 MB (client_max_body_size) before they get here,
# so uploads stop at 50 MB although MAX_FILE_SIZE allows 100 MB. Raise this
# only together with nginx's limit (template-owned frontend/nginx.conf).
MAX_UPLOAD_SIZE_MB=50

# S3/Ceph configuration
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_BUCKET_DOCS=inventory-docs
S3_BUCKET_IMAGES=inventory-images

# OpenAI configuration
OPENAI_API_KEY=your-openai-api-key-here
